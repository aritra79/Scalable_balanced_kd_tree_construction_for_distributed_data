def transform_PD_trigonometric_product_tensor_to_trigonometric_tensor(U, J):
    """
    Transforms a P-dimensional tensor of trigonometric product SEP statistics into trigonometric SEP statistics
    by applying `transform_1D_trigonometric_product_vector_to_trigonometric_vector` along each axis.
    """
    # Import all the necessary Python modules
    import numpy
    
    # Import "epstatKDTree" module
    import epstatKDTree

    # Infer P = tensor dimensionality based on total length reduction ratio
    P = int(numpy.log(U.shape[0]) / numpy.log(2 * numpy.prod(J) + 1))

    # Wrapper for axis-wise transformation
    def lambda_warpper(U_axis):
        return epstatKDTree.transform_1D_trigonometric_product_vector_to_trigonometric_vector(U_axis, J)

    # Apply transformation sequentially along all axes
    for d in range(P):
        U = numpy.apply_along_axis(lambda_warpper, d, U)
    return U





def calculate_multiplier_along_axis(a, b, J):
    """
    Calculate the first 2J+1 Fourier multipliers g_j(a, b) for the indicator 1(a < x < b)
    as in Lemma 3.1 of Chakravorty et al. (2022).
    """
    # Import all the necessary Python modules
    import numpy
    
    # Initialize numpy array with zeros 
    g = numpy.zeros(2*J+1)
    
    # Set increments for for loop
    a_inc = 2*a
    b_inc = 2*b
    
    # Set value for the constant term 
    g[0] = 1
    
    # The lower limit 'a' only influnces 'g' if a > 0
    if a > 0:
        # Adjust value for the constant term
        g[0] -= .5
        
        for j in range(1, 2 * J, 2):
            # Adjust values for the odd terms
            g[j] -= 2 / (numpy.pi * j) * numpy.sin(a)
            
            # Adjust values for the even terms
            g[j+1] += 2 / (numpy.pi * j) * numpy.cos(a)
            
            # Incremental step
            a += a_inc
    
    # The upper limit 'b' only influnces 'g' if b < 0
    if b < 1:
        # Adjust value for the constant term
        g[0] -= .5
        
        for j in range(1, 2 * J, 2):
            # Adjust values for the odd terms
            g[j] += 2 / (numpy.pi * j) * numpy.sin(b)
            
            # Adjust values for the even terms
            g[j+1] -= 2 / (numpy.pi * j) * numpy.cos(b)
            
            # Incremental step
            b += b_inc
    
    return(g)








def calculate_multipliers_conditional(sep, a, b, d):
    """
    Calculate the first 2J+1 conditional multipliers $\bar{C}_{d, j}(X, a, b)$ as seen from the calucations in the previous section.
    """
    # Import all the necessary Python modules
    import numpy
    
    # Import "epstatKDTree" module
    import epstatKDTree
         
    # Extract dimension P from sep.shape
    P = len(sep.shape)
    
    # Extract number of fourier series terms J from sep.shape
    J = int((sep.shape[0] - 1) / 2)
    
    # Transform and mold the SEP tensor into matrix
    sep_rolled = numpy.rollaxis(sep, d).reshape(2*J+1, (2*J+1)**(P-1))
    
    # Calculate the approximate indicator multiplier
    multiplier_indicator = 1
    
    # Iterate over evey dimensions of (a, b)
    for t in range(P):
        
        # Skip for t == d, take outer-product otherwise
        if t != d:
            multiplier_indicator = numpy.outer(multiplier_indicator, epstatKDTree.calculate_multiplier_along_axis(a[t], b[t], J))
    
    # Vectorize the final indicator multiplier tensor
    multiplier_indicator = multiplier_indicator.ravel()
    
    # Take dot-product of the two
    multipliers_conditional = sep_rolled.dot(multiplier_indicator)
    
    return(multipliers_conditional)





def calculate_conditional_median(sep, a, b, d):

    # Import all the necessary Python modules
    import scipy.optimize
    
    # Import "epstatKDTree" module
    import epstatKDTree
    
    # Extract dimension p from sep.shape
    p = len(sep.shape)
    
    # Extract number of fourier series terms J from sep.shape
    J = int((sep.shape[0] - 1) / 2)

    # Calculate conditional multipliers
    if p == 1:
        # If p == 1, fetch multipliers for regular median based on fourier-series expansion
        multiplier = sep.ravel()
    else:
        # If p > 1, calculate multipliers for conditional median
        multiplier = epstatKDTree.calculate_multipliers_conditional(sep, a, b, d)

    # Define functions for brentq optimizer    
    def lambda_median(m):
        return(multiplier.dot(epstatKDTree.calculate_multiplier_along_axis(a[d], m, J) - epstatKDTree.calculate_multiplier_along_axis(m, b[d], J)))
    
    # Optimization step
    median = scipy.optimize.brentq(lambda m: lambda_median(m), a[d], b[d])
    
    return(median)


def transform_sep_to_normalized_intervals_metadata(sep, variables_unique, normalized_intervals, d, boundaries):

    # Import all the necessary Python modules
    import numpy
    
    # Import "epstatKDTree" module
    import epstatKDTree
    
    # Extract dimension 'P' from 'sep.shape'
    P = len(sep.shape)
    
    # Extract number of terms 'J' in Fourier-series approximation from 'sep.shape'
    J = int((sep.shape[0] - 1) / 2)

    # Collect the number of intervals in 'normalized_intervals'
    num_intervals = normalized_intervals.shape[0]
    
    # Fetch the upper and the lower bounds for all relevant unique variables used in this construction
    lower = numpy.array([boundaries['lower'][variable] for variable in variables_unique])
    upper = numpy.array([boundaries['upper'][variable] for variable in variables_unique])
    
    # Initialize the array of cells and conditional medians
    new_normalized_intervals = numpy.empty((2*num_intervals, 2, P))
    conditional_medians = numpy.empty(I)
    
    # Run loop for each 'interval' in 'normalized_intervals'
    for i in range(num_intervals):

        # Fetch the i^th 'interval'
        interval = normalized_intervals[i]

        # Calculate the 'conditional_median' for the current 'interval'
        conditional_median_normalised = epstatKDTree.calculate_median_conditionl(sep, interval[0], interval[1], d)
        conditional_medians[i] = conditional_median_normalised * (upper[d] - lower[d]) + lower[d]

        # Construct interval corresponding to left child of 'normalized_intervals[i]'
        new_normalized_intervals[2*i] = interval
        new_normalized_intervals[2*i][1][d] = conditional_median_normalised

        # Construct cell corresponding to right child of 'normalized_cells[i]'
        new_normalized_intervals[2*i+1] = interval
        new_normalized_intervals[2*i+1][0][d] = conditional_median_normalised

    # Store 'new_normalized_intervals' and 'conditional_medians' in the dictionary 'normalized_intervals_metadata'
    normalized_intervals_metadata = {'normalized_intervals' : new_normalized_intervals, 'conditional_medians' : conditional_medians}
    
    return(normalized_intervals_metadata)


